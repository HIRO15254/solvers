+/// Freezes skipped rows (no discount, no add) and scales caught-up rows.
+fn rbp_adjust<V: crate::storage::StorageOps + ?Sized>(
+    storage: &V,
+    sref: StorageRef,
+    inst: &mut [f32],
+    skip: u64,
+    catchup: u64,
+    d: &Discounts,
+) {
+    let hands = sref.num_hands as usize;
+    if skip != 0 {
+        let mut regrets = vec![0.0; sref.len()];
+        storage.raw_regrets(sref, sref.index, &mut regrets);
+        let neg = d.neg as f32;
+        for a in 0..sref.num_actions as usize {
+            if skip >> a & 1 == 1 {
+                for (v, &r) in inst[a * hands..(a + 1) * hands]
+                    .iter_mut()
+                    .zip(&regrets[a * hands..(a + 1) * hands])
+                {
