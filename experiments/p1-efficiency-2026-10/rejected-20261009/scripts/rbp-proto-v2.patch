+/// (skip mask, catch-up mask) for an own node after regret matching.
+fn rbp_masks(sigma: &[f32], sref: StorageRef) -> (u64, u64) {
+    let phase = RBP_PHASE.load(std::sync::atomic::Ordering::Relaxed);
+    if phase == PHASE_OFF {
+        return (0, 0);
+    }
+    let slot = &RBP_MASKS.get().expect("masks sized in step")[sref.index as usize];
+    if phase == PHASE_SKIP {
