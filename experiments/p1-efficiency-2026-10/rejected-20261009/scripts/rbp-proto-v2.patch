+/// Bit `a` set when every hand that is not in the exact uniform (zero
+/// positive regret) state has probability zero on action `a`.
+fn zero_rows(sigma: &[f32], num_actions: usize, num_hands: usize) -> u64 {
+    if num_actions > 64 || num_hands == 0 {
+        return 0;
+    }
+    let uniform = 1.0 / num_actions as f32;
+    let mut used = 0u64;
+    let mut any_live = false;
+    for h in 0..num_hands {
+        if (0..num_actions).all(|a| sigma[a * num_hands + h] == uniform) {
+            continue;
+        }
+        any_live = true;
+        for a in 0..num_actions {
+            if sigma[a * num_hands + h] != 0.0 {
+                used |= 1 << a;
+            }
+        }
+    }
+    if !any_live {
+        return 0;
+    }
+    let all = if num_actions == 64 { u64::MAX } else { (1u64 << num_actions) - 1 };
+    !used & all
+}
