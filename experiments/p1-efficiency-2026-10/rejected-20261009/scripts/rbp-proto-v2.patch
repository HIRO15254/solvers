+    }
+    let fresh = zero_rows(sigma, sref.num_actions as usize, sref.num_hands as usize);
+    let previous = slot.swap(fresh, std::sync::atomic::Ordering::Relaxed);
+    (0, if *RBP_CATCHUP { previous } else { 0 })
+}
