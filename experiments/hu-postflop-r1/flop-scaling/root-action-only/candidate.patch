+#[cfg(test)]
+mod root_action_only_tests {
+    use super::*;
+    use crate::tree::{ReachMap, TempNode, TreeSpec};
+
+    fn action(player: Player, count: usize) -> TempNode {
+        TempNode::Action {
+            player,
+            children: (0..count)
+                .map(|_| TempNode::Terminal { id: 0, tag: 0 })
+                .collect(),
+            tag: 0,
+        }
+    }
+
+    fn chance(child: TempNode) -> TempNode {
+        TempNode::Chance {
+            deals: vec![(
+                1.0,
+                PerPlayer::new(ReachMap::Identity, ReachMap::Identity),
+                child,
+            )],
+            tag: 0,
+        }
+    }
+
+    fn tree(root: TempNode) -> PublicTree {
+        PublicTree::compile(TreeSpec {
+            root,
+            masks: Vec::new(),
+            transitions: Vec::new(),
+            root_dims: PerPlayer::new(4_095, 2_048),
+        })
+    }
+
+    fn mixed_root(second_large: bool) -> PublicTree {
+        tree(TempNode::Action {
+            player: Player::P0,
+            children: vec![
+                chance(action(Player::P1, 2)), // exactly 4,096 elements
+                chance(if second_large {
+                    action(Player::P1, 2)
+                } else {
+                    action(Player::P0, 1) // exactly 4,095 elements
+                }),
+            ],
+            tag: 0,
+        })
+    }
+
+    #[test]
+    fn cfr_mixed_root_requires_two_large_children_and_only_marks_root() {
+        for workers in [2, 4, 16, 32] {
+            rayon::ThreadPoolBuilder::new()
+                .num_threads(workers)
+                .build()
+                .unwrap()
+                .install(|| {
+                    assert!(ActionPlan::for_cfr(&mixed_root(false)).is_none());
+                    let tree = mixed_root(true);
+                    // Existing quality/default plan remains disabled.
+                    assert!(ActionPlan::new(&tree).is_none());
+                    let plan = ActionPlan::for_cfr(&tree).unwrap();
+                    assert!(plan.nodes[0].here && plan.nodes[0].below);
+                    assert!(plan.nodes[1..].iter().all(|p| !p.here && !p.below));
+                });
+        }
+    }
+
+    #[test]
+    fn cfr_mixed_root_does_not_search_below_a_single_heavy_child() {
+        let tree = tree(TempNode::Action {
+            player: Player::P0,
+            children: vec![TempNode::Terminal { id: 0, tag: 0 }, {
+                TempNode::Action {
+                    player: Player::P1,
+                    children: vec![chance(action(Player::P1, 2)), chance(action(Player::P1, 2))],
+                    tag: 0,
+                }
+            }],
+            tag: 0,
+        });
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(4)
+            .build()
+            .unwrap()
+            .install(|| assert!(ActionPlan::for_cfr(&tree).is_none()));
+    }
+
+    #[test]
+    fn cfr_serial_and_chance_root_remain_without_action_plan() {
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(1)
+            .build()
+            .unwrap()
+            .install(|| assert!(ActionPlan::for_cfr(&mixed_root(true)).is_none()));
+        let chance_root = tree(chance(TempNode::Action {
+            player: Player::P0,
+            children: vec![action(Player::P1, 2), action(Player::P1, 2)],
+            tag: 0,
+        }));
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(4)
+            .build()
+            .unwrap()
+            .install(|| assert!(ActionPlan::for_cfr(&chance_root).is_none()));
+    }
+
+    #[test]
+    fn cfr_chance_free_plan_is_identical_to_existing_plan() {
+        let tree = tree(TempNode::Action {
+            player: Player::P0,
+            children: vec![action(Player::P1, 2), action(Player::P1, 2)],
+            tag: 0,
+        });
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(4)
+            .build()
+            .unwrap()
+            .install(|| {
+                let original = ActionPlan::new(&tree).unwrap();
+                let cfr = ActionPlan::for_cfr(&tree).unwrap();
+                assert_eq!(original.nodes.len(), cfr.nodes.len());
+                for (a, b) in original.nodes.iter().zip(&cfr.nodes) {
+                    assert_eq!((a.here, a.below), (b.here, b.below));
+                }
+            });
+    }
+}
