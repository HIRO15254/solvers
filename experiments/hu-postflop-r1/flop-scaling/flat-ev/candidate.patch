+/// Borrow disjoint variable-length chance outputs, including empty rows.
+fn chance_output_rows<'a>(values: &'a mut [f32], dims: &[usize]) -> Vec<&'a mut [f32]> {
+    let mut rest = values;
+    let mut rows = Vec::with_capacity(dims.len());
+    for &dim in dims {
+        let (row, tail) = rest.split_at_mut(dim);
+        rows.push(row);
+        rest = tail;
+    }
+    assert!(
+        rest.is_empty(),
+        "chance output dimensions do not cover buffer"
+    );
+    rows
+}
