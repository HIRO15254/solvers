
#[cfg(test)]
mod sigma_scratch_tests {
    use super::Scratch;
    use crate::{
        Discounts, F32Storage, I16Storage, Storage, StorageOps, StorageRef, StorageSpan,
        StorageView,
    };

    fn bits(values: &[f32]) -> Vec<u32> {
        values.iter().map(|value| value.to_bits()).collect()
    }

    #[test]
    fn overwrite_take_preserves_initialized_dirty_values() {
        let dirty = [3.5, -0.0, f32::from_bits(0x7fc0_0123), -7.0];
        let mut scratch = Scratch::new();
        scratch.put(dirty.to_vec());
        assert_eq!(bits(&scratch.take_for_overwrite(dirty.len())), bits(&dirty));
    }

    #[test]
    fn overwrite_take_resizes_and_initializes_only_the_new_tail() {
        let mut scratch = Scratch::new();
        assert_eq!(bits(&scratch.take_for_overwrite(3)), vec![0; 3]);
        scratch.put(vec![2.0, -0.0, 8.0, 9.0]);
        let shrunk = scratch.take_for_overwrite(2);
        assert_eq!(bits(&shrunk), bits(&[2.0, -0.0]));
        scratch.put(shrunk);
        let grown = scratch.take_for_overwrite(5);
        assert_eq!(bits(&grown), bits(&[2.0, -0.0, 0.0, 0.0, 0.0]));
        scratch.put(grown);
        let empty = scratch.take_for_overwrite(0);
        assert!(empty.is_empty());
        scratch.put(empty);
        assert_eq!(bits(&scratch.take_for_overwrite(4)), vec![0; 4]);
    }

    #[test]
    fn existing_take_still_zeroes_dirty_same_shrunk_and_grown_buffers() {
        for len in [4, 2, 7, 0] {
            let mut scratch = Scratch::new();
            scratch.put(vec![f32::NAN, -0.0, 8.0, -9.0]);
            assert_eq!(bits(&scratch.take(len)), vec![0; len]);
        }
        let mut scratch = Scratch::new();
        scratch.put(vec![1.0]);
        scratch.put(vec![2.0]);
        assert_eq!(scratch.take_for_overwrite(1), vec![2.0]);
        assert_eq!(scratch.take_for_overwrite(1), vec![1.0]);
    }

    fn check_output<S: StorageOps>(storage: &S, r: StorageRef) -> Vec<f32> {
        let mut zeroed = vec![0.0; r.len()];
        storage.regret_matching(r, r.index, &mut zeroed);
        let mut scratch = Scratch::new();
        scratch.put(vec![f32::from_bits(0x7fc0_0123); r.len()]);
        let mut dirty = scratch.take_for_overwrite(r.len());
        storage.regret_matching(r, r.index, &mut dirty);
        assert_eq!(bits(&dirty), bits(&zeroed));
        assert!(dirty.iter().all(|value| value.is_finite()));
        zeroed
    }

    fn check_backend<S: Storage>() {
        // Nonzero element and ref offsets also exercise split-view rebasing.
        let r = StorageRef {
            offset: 5,
            num_actions: 3,
            num_hands: 4,
            index: 1,
        };
        let mut storage = S::new(r.offset + r.len() + 2, 3);
        storage.update_regrets(
            r,
            r.index,
            &[
                0.0, -2.0, 1.0, 2.0, 0.0, -1.0, 3.0, -1.0, 0.0, -3.0, 2.0, 0.0,
            ],
            &Discounts {
                pos: 1.0,
                neg: 1.0,
                avg: 1.0,
                floor_neg: false,
                reset_avg: false,
            },
        );
        let before = storage.state();
        let full = check_output(&storage, r);
        // Both normalization branches: zero/negative-only columns are uniform;
        // a positive column is normalized, and one positive action gets all mass.
        for a in 0..3 {
            assert_eq!(full[a * 4].to_bits(), (1.0_f32 / 3.0).to_bits());
            assert_eq!(full[a * 4 + 1].to_bits(), (1.0_f32 / 3.0).to_bits());
        }
        assert!(full[6] > full[10] && full[10] > full[2]);
        assert!((full[2] + full[6] + full[10] - 1.0).abs() < 2.0e-7);
        assert_eq!(bits(&[full[3], full[7], full[11]]), bits(&[1.0, 0.0, 0.0]));
        {
            let mut view = storage.view_mut();
            assert_eq!(bits(&check_output(&view, r)), bits(&full));
            let mut split = view.split(&[StorageSpan {
                start: r.offset,
                end: r.offset + r.len(),
                sref_start: r.index,
                sref_end: r.index + 1,
            }]);
            assert_eq!(bits(&check_output(&split.remove(0), r)), bits(&full));
        }
        assert_eq!(storage.state(), before);

        let empty_ref = StorageRef {
            offset: 0,
            num_actions: 3,
            num_hands: 0,
            index: 0,
        };
        let mut empty = S::new(0, 1);
        assert!(check_output(&empty, empty_ref).is_empty());
        assert!(check_output(&empty.view_mut(), empty_ref).is_empty());
    }

    #[test]
    fn f32_full_and_view_regret_matching_overwrites_dirty_strategy() {
        check_backend::<F32Storage>();
    }

    #[test]
    fn i16_full_and_view_regret_matching_overwrites_dirty_strategy() {
        check_backend::<I16Storage>();
    }
}
