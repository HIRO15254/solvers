+#[cfg(test)]
+mod scratch_bank_tests {
+    use super::*;
+    use crate::schedule::Dcfr;
+    use crate::storage::{F32Storage, I16Storage};
+    use crate::tree::{ReachMap, TempNode, TreeSpec};
+    use std::panic::{AssertUnwindSafe, catch_unwind};
