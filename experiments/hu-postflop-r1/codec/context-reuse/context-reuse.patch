+// Research candidate: one private context per artifact, shared only by node chunks.
+// Metadata keeps its separate encode_all path and unchanged frame settings.
+fn chunk_zstd_error(code: zstd::zstd_safe::ErrorCode) -> std::io::Error {
+    std::io::Error::other(zstd::zstd_safe::get_error_name(code).to_owned())
+}
+
+fn write_chunk_reusing_context<W: Write>(
+    writer: W,
+    raw: &[u8],
+    context: &mut Option<zstd::zstd_safe::CCtx<'static>>,
+) -> std::io::Result<W> {
+    use zstd::zstd_safe::{CCtx, CParameter, ResetDirective};
+
+    if context.is_none() {
+        // Match raw::Encoder::new(0), including its allocation-failure behavior.
+        let mut fresh = CCtx::create();
+        fresh
+            .set_parameter(CParameter::CompressionLevel(0))
+            .map_err(chunk_zstd_error)?;
+        fresh.load_dictionary(&[]).map_err(chunk_zstd_error)?;
+        *context = Some(fresh);
+    }
+    let context = context.as_mut().expect("context initialized above");
+    // Drop frame history and restore unknown pledged size; keep level/dictionary.
+    context
+        .reset(ResetDirective::SessionOnly)
+        .map_err(chunk_zstd_error)?;
+    let mut encoder = zstd::Encoder::with_context(writer, context);
+    encoder.include_checksum(true)?;
+    encoder.write_all(raw)?;
+    // Only a successfully completed and fully written frame permits another chunk.
+    encoder.finish()
+}
