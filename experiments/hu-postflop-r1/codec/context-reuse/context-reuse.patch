+#[cfg(test)]
+mod context_reuse_tests {
+    use super::write_chunk_reusing_context;
+    use std::io::Write;
+
+    fn fresh_frame(raw: &[u8]) -> Vec<u8> {
+        // Independent old writer sequence: a fresh context for every frame.
+        let mut encoder = zstd::Encoder::new(Vec::new(), 0).unwrap();
+        encoder.include_checksum(true).unwrap();
+        encoder.write_all(raw).unwrap();
+        encoder.finish().unwrap()
+    }
+
+    fn fixed_pseudorandom(len: usize) -> Vec<u8> {
+        let mut state = 0x9e37_79b9_7f4a_7c15u64;
+        (0..len)
+            .map(|_| {
+                state ^= state << 13;
+                state ^= state >> 7;
+                state ^= state << 17;
+                (state >> 56) as u8
+            })
+            .collect()
+    }
+
+    #[test]
+    fn reused_context_matches_fresh_frames_at_stream_buffer_boundaries() {
+        let mut context = None;
+        for len in [
+            0,
+            1,
+            32 * 1024 - 1,
+            32 * 1024,
+            32 * 1024 + 1,
+            128 * 1024 - 1,
+            128 * 1024,
+            128 * 1024 + 1,
+            512 * 1024 + 1,
+        ] {
+            for raw in [vec![0u8; len], fixed_pseudorandom(len)] {
+                let actual = write_chunk_reusing_context(Vec::new(), &raw, &mut context).unwrap();
+                assert_eq!(actual, fresh_frame(&raw), "frame bytes differ at len={len}");
+                assert_eq!(zstd::decode_all(actual.as_slice()).unwrap(), raw);
+            }
+        }
+    }
+
+    #[test]
+    fn large_small_large_frames_do_not_carry_history_or_pledged_size() {
+        let large = fixed_pseudorandom(1024 * 1024 + 11);
+        let small = [0x61, 0x62, 0x61];
+        let mut context = None;
+        let mut first = None;
+        for (index, raw) in [large.as_slice(), small.as_slice(), large.as_slice()]
+            .into_iter()
+            .enumerate()
+        {
+            let actual = write_chunk_reusing_context(Vec::new(), raw, &mut context).unwrap();
+            assert_eq!(actual, fresh_frame(raw), "frame {index} differs");
+            assert_eq!(zstd::decode_all(actual.as_slice()).unwrap(), raw);
+            if index == 0 {
+                first = Some(actual);
+            } else if index == 2 {
+                assert_eq!(Some(actual), first);
+            }
+        }
+    }
+}
