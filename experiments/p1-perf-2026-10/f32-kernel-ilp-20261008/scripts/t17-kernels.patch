+/// Four lanes break total/high-card dependency chains. Combine in a fixed
+/// pairwise order; the tail goes to lane zero. Padded arrays let LLVM prove
+/// masked card indices are in bounds in safe Rust (real cards are 0..52).
+pub(crate) fn compat_sums_relaxed_f32(hands: &[Hand], reach: &[f32]) -> (f32, [f32; 64]) {
+    let mut totals = [0.0; 4];
+    let mut cards = [[0.0; 64]; 4];
+    let mut chunks = hands.chunks_exact(4);
+    for chunk in &mut chunks {
+        for lane in 0..4 {
+            let h = chunk[lane];
+            let r = reach[h.local as usize];
+            totals[lane] += r;
+            cards[lane][h.cards[0] as usize & 63] += r;
+            cards[lane][h.cards[1] as usize & 63] += r;
+        }
+    }
+    for h in chunks.remainder() {
+        let r = reach[h.local as usize];
+        totals[0] += r;
+        cards[0][h.cards[0] as usize & 63] += r;
+        cards[0][h.cards[1] as usize & 63] += r;
+    }
+    let mut card = [0.0; 64];
+    for (i, sum) in card.iter_mut().enumerate() {
+        *sum = (cards[0][i] + cards[1][i]) + (cards[2][i] + cards[3][i]);
+    }
+    ((totals[0] + totals[1]) + (totals[2] + totals[3]), card)
