new file mode 100644
index 0000000..3a8f4fc
--- /dev/null
+++ b/crates/hu-postflop/tests/pdcfr.rs
@@ -0,0 +1,71 @@
+use hu_engine::{CfrPrecision, ParConfig, PdcfrPlus, PredF32Storage, Solver, StorageState};
+use hu_postflop::game::{ChipEv, NoRake, PayoffPipeline};
+use nlh::Player;
+
+fn solve(threads: usize, precision: CfrPrecision) -> (StorageState, f64, f64) {
+    rayon::ThreadPoolBuilder::new()
+        .num_threads(threads)
+        .build()
+        .unwrap()
+        .install(|| {
+            let game = hu_postflop::game::leduc(PayoffPipeline {
+                rake: &NoRake,
+                utility: &ChipEv,
+            })
+            .game;
+            let mut solver = Solver::<_, PredF32Storage>::new(
+                game,
+                Box::new(PdcfrPlus {
+                    alpha: 2.3,
+                    gamma: 5.0,
+                }),
+                Some(80),
+            );
+            solver.set_cfr_precision(precision);
+            solver.set_par(ParConfig {
+                chance_depth: 2,
+                min_children: 2,
+            });
+            let expl = solver.exploitability();
+            let initial = expl[Player::P0] + expl[Player::P1];
+            solver.run(80);
+            let expl = solver.exploitability();
+            (
+                solver.state().storage,
+                initial,
+                expl[Player::P0] + expl[Player::P1],
+            )
+        })
+}
+
+#[test]
+fn predictive_leduc_converges_and_is_bit_identical_across_threads() {
+    for precision in [CfrPrecision::F64, CfrPrecision::F32] {
+        let (one, initial, final_nash_conv) = solve(1, precision);
+        assert!(
+            final_nash_conv < initial * 0.1,
+            "{precision:?}: {initial} -> {final_nash_conv}"
+        );
+        let (four, _, _) = solve(4, precision);
+        let StorageState::F32 {
+            regrets: a,
+            strategy_sum: b,
+        } = one
+        else {
+            panic!()
+        };
+        let StorageState::F32 {
+            regrets: c,
+            strategy_sum: d,
+        } = four
+        else {
+            panic!()
+        };
+        for (a, b) in [(&a, &c), (&b, &d)] {
+            assert_eq!(
+                a.iter().map(|v| v.to_bits()).collect::<Vec<_>>(),
+                b.iter().map(|v| v.to_bits()).collect::<Vec<_>>()
+            );
+        }
+    }
+}
