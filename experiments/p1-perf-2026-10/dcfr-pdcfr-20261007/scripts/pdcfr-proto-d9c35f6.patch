+use super::*;
+
+/// Experimental predictive f32 backend: three flat f32 arenas.
+/// Checkpoints retain the F32 format and discard predictions.
+pub struct PredF32Storage {
+    inner: F32Storage,
+    pred: Vec<f32>,
+    weight: f32,
+}
+
+pub struct PredF32View<'a> {
+    inner: F32View<'a>,
+    pred: &'a mut [f32],
+    weight: f32,
+}
+
+fn update(
+    regrets: &mut [f32],
+    pred: &mut [f32],
+    offset: usize,
+    r: StorageRef,
+    inst: &[f32],
+    d: &Discounts,
+) {
+    let regrets = &mut regrets[offset..offset + r.len()];
+    let pred = &mut pred[offset..offset + r.len()];
+    debug_assert_eq!(inst.len(), regrets.len());
+    let weight = d.pos as f32;
+    for ((regret, prediction), &delta) in regrets.iter_mut().zip(pred).zip(inst) {
+        *regret = (*regret * weight + delta).max(0.0);
+        *prediction = delta;
+    }
+}
+
+// Reuse the output for predicted positive regrets, then normalize in blocks
+// with the action order and arithmetic of the existing normalization kernels.
+fn matching(
+    regrets: &[f32],
+    pred: &[f32],
+    weight: f32,
+    r: StorageRef,
+    out: &mut [f32],
+    precision: CfrPrecision,
+) {
+    debug_assert_eq!(out.len(), r.len());
+    for ((dst, &regret), &prediction) in out
+        .iter_mut()
+        .zip(&regrets[r.offset..r.offset + r.len()])
+        .zip(&pred[r.offset..r.offset + r.len()])
+    {
+        *dst = (weight * regret + prediction).max(0.0);
+    }
+    let hands = r.num_hands as usize;
+    let actions = r.num_actions as usize;
+    let uniform = 1.0 / actions as f32;
+    const BLOCK: usize = 256;
+    for first in (0..hands).step_by(BLOCK) {
+        let len = BLOCK.min(hands - first);
+        match precision {
+            CfrPrecision::F64 => {
+                let mut totals = [0.0f64; BLOCK];
+                for a in 0..actions {
+                    for (total, &value) in totals[..len]
+                        .iter_mut()
+                        .zip(&out[a * hands + first..a * hands + first + len])
+                    {
+                        *total += value as f64;
+                    }
+                }
+                for a in 0..actions {
+                    for (value, &total) in out[a * hands + first..a * hands + first + len]
+                        .iter_mut()
+                        .zip(&totals[..len])
+                    {
+                        *value = if total > 0.0 {
+                            (*value as f64 / total) as f32
+                        } else {
+                            uniform
+                        };
+                    }
+                }
+            }
+            CfrPrecision::F32 => {
+                let mut totals = [0.0f32; BLOCK];
+                for a in 0..actions {
+                    for (total, &value) in totals[..len]
+                        .iter_mut()
+                        .zip(&out[a * hands + first..a * hands + first + len])
+                    {
+                        *total += value;
+                    }
+                }
+                let mut inverses = [0.0f32; BLOCK];
+                for (inverse, &total) in inverses[..len].iter_mut().zip(&totals[..len]) {
+                    *inverse = if total > 0.0 { total.recip() } else { 0.0 };
+                }
+                for a in 0..actions {
+                    for ((value, &total), &inverse) in out
+                        [a * hands + first..a * hands + first + len]
+                        .iter_mut()
+                        .zip(&totals[..len])
+                        .zip(&inverses[..len])
+                    {
+                        *value = if total > 0.0 {
+                            *value * inverse
+                        } else {
+                            uniform
+                        };
+                    }
+                }
+            }
+        }
+    }
+}
+
+impl StorageOps for PredF32Storage {
+    fn regret_matching(&self, r: StorageRef, idx: u32, out: &mut [f32]) {
+        self.regret_matching_cfr(r, idx, out, CfrPrecision::F64);
+    }
+    fn regret_matching_cfr(&self, r: StorageRef, _idx: u32, out: &mut [f32], norm: CfrPrecision) {
+        self.assert_regrets_available();
+        matching(&self.inner.regrets, &self.pred, self.weight, r, out, norm);
+    }
+    fn update_regrets(&mut self, r: StorageRef, _idx: u32, inst: &[f32], d: &Discounts) {
+        self.assert_regrets_available();
+        update(
+            &mut self.inner.regrets,
+            &mut self.pred,
+            r.offset,
+            r,
+            inst,
+            d,
+        );
+    }
+    fn accumulate_strategy(&mut self, r: StorageRef, idx: u32, weighted: &[f32], d: &Discounts) {
+        self.inner.accumulate_strategy(r, idx, weighted, d);
+    }
+    fn average_strategy(&self, r: StorageRef, idx: u32, out: &mut [f32]) {
+        self.inner.average_strategy(r, idx, out);
+    }
+    fn raw_regrets(&self, r: StorageRef, idx: u32, out: &mut [f32]) {
+        self.inner.raw_regrets(r, idx, out);
+    }
+}
+
+impl Storage for PredF32Storage {
+    type View<'a> = PredF32View<'a>;
+    fn new(len: usize, refs: usize) -> Self {
+        Self {
+            inner: F32Storage::new(len, refs),
+            pred: vec![0.0; len],
+            weight: 1.0,
+        }
+    }
+    fn begin_iteration(&mut self, d: &Discounts) {
+        self.assert_regrets_available();
+        self.weight = d.pos as f32;
+    }
+    fn release_regrets(&mut self) {
+        self.inner.release_regrets();
+        self.pred = Vec::new();
+    }
+    fn regrets_released(&self) -> bool {
+        self.inner.regrets_released()
+    }
+    fn view_mut(&mut self) -> Self::View<'_> {
+        PredF32View {
+            inner: self.inner.view_mut(),
+            pred: &mut self.pred,
+            weight: self.weight,
+        }
+    }
+    fn bytes_for(len: usize, _refs: usize) -> u64 {
+        12 * len as u64
+    }
+    fn state(&self) -> StorageState {
+        self.inner.state()
+    }
+    fn restore_state(&mut self, state: StorageState) -> Result<(), StateMismatch> {
+        self.inner.restore_state(state)?;
+        self.pred.fill(0.0);
+        self.weight = 1.0;
+        Ok(())
+    }
+    fn arrays(&self) -> StorageArrays<'_> {
+        self.inner.arrays()
+    }
+    fn arrays_mut(&mut self) -> StorageArraysMut<'_> {
+        self.assert_regrets_available();
+        // Streaming restoration also loses the last instantaneous regrets.
+        self.pred.fill(0.0);
+        self.weight = 1.0;
+        self.inner.arrays_mut()
+    }
+    fn scale_all(&mut self, regret: f32, strategy: f32) {
+        self.inner.scale_all(regret, strategy);
+        for value in &mut self.pred {
+            *value *= regret;
+        }
+    }
+}
+
+impl StorageOps for PredF32View<'_> {
+    fn regret_matching(&self, r: StorageRef, idx: u32, out: &mut [f32]) {
+        self.regret_matching_cfr(r, idx, out, CfrPrecision::F64);
+    }
+    fn regret_matching_cfr(
+        &self,
+        mut r: StorageRef,
+        _idx: u32,
+        out: &mut [f32],
+        norm: CfrPrecision,
+    ) {
+        r.offset = self.inner.local_offset(r);
+        matching(self.inner.regrets, self.pred, self.weight, r, out, norm);
+    }
+    fn update_regrets(&mut self, r: StorageRef, _idx: u32, inst: &[f32], d: &Discounts) {
+        let offset = self.inner.local_offset(r);
+        update(self.inner.regrets, self.pred, offset, r, inst, d);
+    }
+    fn accumulate_strategy(&mut self, r: StorageRef, idx: u32, weighted: &[f32], d: &Discounts) {
+        self.inner.accumulate_strategy(r, idx, weighted, d);
+    }
+    fn average_strategy(&self, r: StorageRef, idx: u32, out: &mut [f32]) {
+        self.inner.average_strategy(r, idx, out);
+    }
+    fn raw_regrets(&self, r: StorageRef, idx: u32, out: &mut [f32]) {
+        self.inner.raw_regrets(r, idx, out);
+    }
+}
+
+impl StorageView for PredF32View<'_> {
+    fn split(&mut self, spans: &[StorageSpan]) -> Vec<Self> {
+        let base = self.inner.base;
+        let views = self.inner.split(spans);
+        let mut rest = std::mem::take(&mut self.pred);
+        let mut consumed = 0;
+        let mut out = Vec::with_capacity(spans.len());
+        for (inner, span) in views.into_iter().zip(spans) {
+            let (_, tail) = rest.split_at_mut(span.start - base - consumed);
+            let (pred, tail) = tail.split_at_mut(span.end - span.start);
+            out.push(Self {
+                inner,
+                pred,
+                weight: self.weight,
+            });
+            rest = tail;
+            consumed = span.end - base;
+        }
+        out
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{DiscountSchedule, PdcfrPlus};
+
+    fn bits(values: &[f32]) -> Vec<u32> {
+        values.iter().map(|v| v.to_bits()).collect()
+    }
+
+    #[test]
+    fn hand_calculated_predictive_updates() {
+        let r = StorageRef {
+            offset: 0,
+            num_actions: 2,
+            num_hands: 2,
+            index: 0,
+        };
+        let schedule = PdcfrPlus {
+            alpha: 2.3,
+            gamma: 5.0,
+        };
+        let mut storage = PredF32Storage::new(4, 1);
+        let mut out = [0.0; 4];
+        let first = schedule.at(1, None);
+        storage.begin_iteration(&first);
+        storage.regret_matching_cfr(r, 0, &mut out, CfrPrecision::F64);
+        assert_eq!(out, [0.5; 4]);
+        storage.update_regrets(r, 0, &[2.0, -1.0, -1.0, 1.0], &first);
+        assert_eq!(storage.inner.regrets, [2.0, 0.0, 0.0, 1.0]);
+        assert_eq!(storage.pred, [2.0, -1.0, -1.0, 1.0]);
+        storage.accumulate_strategy(r, 0, &[0.5; 4], &first);
+        let second = schedule.at(2, None);
+        assert_eq!(second.pos, 0.5);
+        storage.begin_iteration(&second);
+        for precision in [CfrPrecision::F64, CfrPrecision::F32] {
+            storage.regret_matching_cfr(r, 0, &mut out, precision);
+            assert_eq!(out, [1.0, 0.0, 0.0, 1.0]);
+        }
+        storage.accumulate_strategy(r, 0, &out, &second);
+        assert_eq!(
+            storage.inner.strategy_sum,
+            [1.015625, 0.015625, 0.015625, 1.015625]
+        );
+        storage.update_regrets(r, 0, &[-3.0, 2.0, 1.0, -1.0], &second);
+        assert_eq!(storage.inner.regrets, [0.0, 2.0, 1.0, 0.0]);
+        assert_eq!(storage.pred, [-3.0, 2.0, 1.0, -1.0]);
+        // Latest R and m must already be visible to the opposing pass.
+        storage.regret_matching_cfr(r, 0, &mut out, CfrPrecision::F64);
+        assert_eq!(out, [0.0, 1.0, 1.0, 0.0]);
+    }
+
+    #[test]
+    fn normalization_matches_existing_precision_kernels() {
+        let r = StorageRef {
+            offset: 0,
+            num_actions: 3,
+            num_hands: 259,
+            index: 0,
+        };
+        let mut storage = PredF32Storage::new(r.len(), 1);
+        storage.weight = 0.71;
+        for j in 0..r.len() {
+            storage.inner.regrets[j] = (j % 11) as f32 * 0.13;
+            storage.pred[j] = (j % 7) as f32 * 0.27 - 1.0;
+        }
+        let predicted: Vec<_> = storage
+            .inner
+            .regrets
+            .iter()
+            .zip(&storage.pred)
+            .map(|(&r, &m)| (storage.weight * r + m).max(0.0))
+            .collect();
+        for precision in [CfrPrecision::F64, CfrPrecision::F32] {
+            let mut expected = vec![0.0; r.len()];
+            match precision {
+                CfrPrecision::F64 => normalize_columns(&predicted, r, &mut expected),
+                CfrPrecision::F32 => normalize_columns_f32(&predicted, r, &mut expected),
+            }
+            let mut actual = vec![0.0; r.len()];
+            storage.regret_matching_cfr(r, 0, &mut actual, precision);
+            assert_eq!(bits(&actual), bits(&expected));
+        }
+    }
+
+    #[test]
+    fn split_views_preserve_all_three_arenas_and_weight() {
+        let mut direct = PredF32Storage::new(30, 2);
+        let mut split = PredF32Storage::new(30, 2);
+        let refs = [
+            StorageRef {
+                offset: 3,
+                num_actions: 3,
+                num_hands: 2,
+                index: 0,
+            },
+            StorageRef {
+                offset: 17,
+                num_actions: 2,
+                num_hands: 3,
+                index: 1,
+            },
+        ];
+        let spans = [
+            StorageSpan {
+                start: 2,
+                end: 10,
+                sref_start: 0,
+                sref_end: 1,
+            },
+            StorageSpan {
+                start: 15,
+                end: 25,
+                sref_start: 1,
+                sref_end: 2,
+            },
+        ];
+        let schedule = PdcfrPlus {
+            alpha: 2.3,
+            gamma: 5.0,
+        };
+        for t in 1..=7 {
+            let d = schedule.at(t, None);
+            direct.begin_iteration(&d);
+            split.begin_iteration(&d);
+            let mut view = split.view_mut();
+            let mut children = view.split(&spans);
+            for (&r, child) in refs.iter().zip(&mut children) {
+                // Split again, with a nonzero base and skipped padding.
+                let mut nested = child.split(&[StorageSpan {
+                    start: r.offset,
+                    end: r.offset + r.len(),
+                    sref_start: r.index,
+                    sref_end: r.index + 1,
+                }]);
+                let child = &mut nested[0];
+                for precision in [CfrPrecision::F64, CfrPrecision::F32] {
+                    let mut a = vec![0.0; r.len()];
+                    let mut b = vec![0.0; r.len()];
+                    direct.regret_matching_cfr(r, r.index, &mut a, precision);
+                    child.regret_matching_cfr(r, r.index, &mut b, precision);
+                    assert_eq!(bits(&a), bits(&b));
+                }
+                let inst: Vec<_> = (0..r.len())
+                    .map(|i| i as f32 * 0.11 - t as f32 * 0.07)
+                    .collect();
+                direct.update_regrets(r, r.index, &inst, &d);
+                child.update_regrets(r, r.index, &inst, &d);
+                direct.accumulate_strategy(r, r.index, &inst, &d);
+                child.accumulate_strategy(r, r.index, &inst, &d);
+            }
+        }
+        assert_eq!(bits(&direct.inner.regrets), bits(&split.inner.regrets));
+        assert_eq!(bits(&direct.pred), bits(&split.pred));
+        assert_eq!(
+            bits(&direct.inner.strategy_sum),
+            bits(&split.inner.strategy_sum)
+        );
+    }
