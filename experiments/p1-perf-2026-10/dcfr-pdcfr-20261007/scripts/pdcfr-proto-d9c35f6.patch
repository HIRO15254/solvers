+/// Experimental switch shared by the solve driver and throughput harness.
+pub fn pdcfr_prototype(storage: input::Storage) -> Result<Option<PdcfrPlus>> {
+    let value = match std::env::var("SOLVERS_P1_PDCFR") {
+        Ok(value) => value,
+        Err(std::env::VarError::NotPresent) => return Ok(None),
+        Err(error) => return Err(error).context("SOLVERS_P1_PDCFR must be Unicode"),
+    };
+    if storage != input::Storage::F32 {
+        bail!("SOLVERS_P1_PDCFR requires f32 storage");
+    }
+    let prototype = parse_pdcfr_prototype(&value)?;
+    eprintln!(
+        "SOLVERS_P1_PDCFR: PDCFR+ alpha={}, gamma={}",
+        prototype.alpha, prototype.gamma
+    );
+    Ok(Some(prototype))
+}
+
+fn parse_pdcfr_prototype(value: &str) -> Result<PdcfrPlus> {
+    let parse = || -> Option<PdcfrPlus> {
+        let (alpha, gamma) = value.split_once(',')?;
+        let alpha: f64 = alpha.trim().parse().ok()?;
+        let gamma: f64 = gamma.trim().parse().ok()?;
+        ((alpha.is_finite() || alpha == f64::INFINITY) && gamma.is_finite() && gamma >= 0.0)
+            .then_some(PdcfrPlus { alpha, gamma })
+    };
+    parse().context(
+        "SOLVERS_P1_PDCFR must be alpha,gamma (finite alpha or inf; finite non-negative gamma)",
+    )
+}
+
+#[cfg(test)]
+mod prototype_tests {
+    use super::parse_pdcfr_prototype;
+
+    #[test]
+    fn parses_predictive_parameters_and_rejects_invalid_values() {
+        let finite = parse_pdcfr_prototype("2.3,5").unwrap();
+        assert_eq!((finite.alpha, finite.gamma), (2.3, 5.0));
+        let infinite = parse_pdcfr_prototype(" inf , 2 ").unwrap();
+        assert_eq!((infinite.alpha, infinite.gamma), (f64::INFINITY, 2.0));
+        for invalid in [
+            "", "2.3", "2.3,5,1", "NaN,5", "-inf,2", "2.3,inf", "2.3,NaN", "2.3,-1",
+        ] {
+            assert!(parse_pdcfr_prototype(invalid).is_err(), "{invalid}");
+        }
+    }
+}
