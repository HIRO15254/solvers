+/// Experimental predictive DCFR+; positive infinity selects PCFR+ weighting.
+#[derive(Clone, Copy, Debug)]
+pub struct PdcfrPlus {
+    pub alpha: f64,
+    pub gamma: f64,
+}
+
+impl DiscountSchedule for PdcfrPlus {
+    fn at(&self, t: u64, _planned: Option<u64>) -> Discounts {
+        let s = (t - 1) as f64;
+        let w = if self.alpha == f64::INFINITY {
+            1.0
+        } else {
+            power_discount(s, self.alpha)
+        };
+        Discounts {
+            pos: w,
+            neg: w,
+            avg: if t > 1 {
+                (s / (s + 1.0)).powf(self.gamma)
+            } else {
+                0.0
+            },
+            floor_neg: true,
+            reset_avg: false,
+        }
+    }
+
+    fn name(&self) -> &'static str {
+        "pdcfr+"
+    }
+}
