+    #[test]
+    fn checkpoint_reset_and_release() {
+        for len in [0, 6] {
+            let mut storage = PredF32Storage::new(len, 1);
+            storage.pred.fill(3.0);
+            let state = storage.state();
+            storage.restore_state(state.clone()).unwrap();
+            assert!(storage.pred.iter().all(|&v| v == 0.0));
+            assert_eq!(storage.state(), state);
+            storage.pred.fill(2.0);
+            let _ = storage.arrays_mut();
+            assert!(storage.pred.iter().all(|&v| v == 0.0));
+            storage.inner.strategy_sum.fill(1.0);
+            storage.release_regrets();
+            storage.release_regrets();
+            assert!(storage.regrets_released());
+            assert_eq!(storage.inner.regrets.capacity(), 0);
+            assert_eq!(storage.pred.capacity(), 0);
+            assert_eq!(storage.inner.strategy_sum, vec![1.0; len]);
+            assert!(std::panic::catch_unwind(|| storage.state()).is_err());
+            if len > 0 {
+                let r = StorageRef {
+                    offset: 0,
+                    num_actions: 2,
+                    num_hands: 3,
+                    index: 0,
+                };
+                let mut out = [0.0; 6];
+                storage.average_strategy(r, 0, &mut out);
+                assert_eq!(out, [0.5; 6]);
+            }
+        }
+    }
+}
