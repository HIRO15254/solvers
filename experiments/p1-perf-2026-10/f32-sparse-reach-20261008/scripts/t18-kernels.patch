+    fn ranked_fixture(board: &[Card], seat: usize) -> RankedHands {
+        let board_set: CardSet = board.iter().copied().collect();
+        let mut ranked = Vec::new();
+        for combo in 0..NUM_COMBOS {
+            // Asymmetric supports, missing ranks, and absent identical hands.
+            if (combo + seat * 3).is_multiple_of(seat + 3) {
+                continue;
+            }
+            let (a, b) = combo_cards(combo);
+            if board_set.contains(a) || board_set.contains(b) {
+                continue;
+            }
+            let rank = if board.is_empty() {
+                HandRank((combo % 29) as u16)
+            } else {
+                rank_of(board.iter().copied().chain([a, b]))
+            };
+            ranked.push((
+                rank,
+                Hand {
+                    local: ranked.len() as u16,
+                    cards: [a.index() as u8, b.index() as u8],
+                },
+            ));
+        }
+        ranked.sort_by_key(|&(rank, h)| (rank, h.local));
+        let mut groups = Vec::new();
+        for (i, &(rank, _)) in ranked.iter().enumerate() {
+            if groups.last().is_none_or(|&(r, _)| r != rank) {
+                groups.push((rank, i + 1));
+            } else {
+                groups.last_mut().unwrap().1 = i + 1;
+            }
+        }
+        RankedHands {
+            hands: ranked.into_iter().map(|(_, h)| h).collect(),
+            groups,
+        }
+    }
