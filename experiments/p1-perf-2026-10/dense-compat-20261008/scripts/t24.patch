+#[test]
+fn dense_compat_sums_match_f64_on_real_supports_and_rank_tables() {
+    let mut maximum = 0.0f64;
+    for support in 0..3 {
+        let mut config = config();
+        let range = |p: Player| {
+            let mut range = nlh::Range::default();
+            for combo in 0..nlh::NUM_COMBOS {
+                let sparse = support == 1 || (support == 2 && p == Player::P1);
+                if !sparse || (combo + p.index() * 3).is_multiple_of(17) {
+                    range.set_weight(combo, ((combo * 17 + p.index()) % 101 + 1) as f32 / 103.0);
+                }
+            }
+            range
+        };
+        config.ranges = PerPlayer::new(range(Player::P0), range(Player::P1));
+        let built = build_postflop_game(
+            &config,
+            PayoffPipeline {
+                rake: &NoRake,
+                utility: &ChipEv,
+            },
+        );
+        let e = &built.game.evaluator;
+        assert!(!e.rank_tables.is_empty());
+        for table in &e.rank_tables {
+            for p in Player::BOTH {
+                let mut live = vec![false; e.hands.len(p)];
+                for h in &table[p].hands {
+                    let (a, b) = combo_cards(e.hands.combos(p)[h.local as usize] as usize);
+                    assert_eq!(h.cards, [a.index() as u8, b.index() as u8]);
+                    live[h.local as usize] = true;
+                }
+                // Dense and sparse live reaches, all-zero, and negative zero;
+                // dead reaches stay zero, including in the full fold support.
+                for pattern in 0..4 {
+                    for scale in [0.001, 1.0, 100.0] {
+                        let reach: Vec<f32> = live
+                            .iter()
+                            .enumerate()
+                            .map(|(i, &live)| match pattern {
+                                3 => -0.0,
+                                2 => 0.0,
+                                _ if live && (pattern == 0 || i % 11 == 0) => {
+                                    ((i * 37 % 101 + 1) as f32 / 103.0) * scale
+                                }
+                                _ => 0.0,
+                            })
+                            .collect();
+                        for list in [&e.fold_combos[p], &table[p].hands] {
+                            let (exact_total, exact_card) = kernel::compat_sums(list, &reach);
+                            let mut dense = [0.0; nlh::NUM_COMBOS];
+                            // Force the dense routine even for sparse supports,
+                            // and also validate the production support-size route.
+                            for (total, card) in [
+                                kernel::dense_compat_sums_f32(
+                                    e.hands.combos(p),
+                                    &reach,
+                                    &mut dense,
+                                ),
+                                kernel::compat_sums_relaxed_f32(list, e.hands.combos(p), &reach),
+                            ] {
+                                for (exact, actual) in std::iter::once((exact_total, total))
+                                    .chain(exact_card.into_iter().zip(card))
+                                {
+                                    assert!(actual.is_finite());
+                                    if exact == 0.0 {
+                                        assert_eq!(actual.to_bits(), 0);
+                                    } else {
+                                        let relative =
+                                            (exact - f64::from(actual)).abs() / exact.abs();
+                                        maximum = maximum.max(relative);
+                                        assert!(relative <= 1e-6, "{p:?} {pattern} {relative:e}");
+                                    }
+                                }
+                            }
+                        }
+                        // Full/sparse asymmetric supports also exercise dense
+                        // own values with small-list opponent sums. The fold
+                        // route must agree bitwise with the fused fold output.
+                        let own = p.opponent();
+                        let mut fold = vec![0.0; e.hands.len(own)];
+                        let mut fused_fold = fold.clone();
+                        let mut show = fold.clone();
+                        kernel::fold_kernel_relaxed_f32(
+                            &table[own].hands,
+                            &table[p].hands,
+                            &e.hands.same[own],
+                            [e.hands.combos(own), e.hands.combos(p)],
+                            -1.5,
+                            0,
+                            &reach,
+                            &mut fold,
+                        );
+                        kernel::showdown_fold_kernel_relaxed_f32(
+                            &table[own],
+                            &table[p],
+                            &e.hands.same[own],
+                            e.hands.combos(p),
+                            [1.25, 0.5, -2.0, -1.5],
+                            &reach,
+                            &mut show,
+                            &mut fused_fold,
+                        );
+                        assert_eq!(bits(&fold), bits(&fused_fold));
+                    }
+                }
+            }
+        }
+    }
+    println!("dense compat sums maximum pointwise relative error: {maximum:e}");
+}
